/* The entire grammar of Blockpilot's command language: the core productions, then one production per command and option, as `help grammar` prints them. Generated by tools/grammar.py; don't edit by hand. */
/* Read as the parser reads it: alternatives are tried in order and the first that matches is taken; ?, * and + take as much as they can and never give it back; a production for a token matches the whole token; A - B matches what A matches unless B matches it too. [C] marks value limits: whole numbers are below 2^31, decimals have at most 9 digits before their point, and a duration is at most 2^31 - 1 ticks. */
/* Line protocol: an auth line, then one request per line */
connection ::= auth-line request*
auth-line ::= "auth" #x20 auth-token line-end
auth-token ::= [^#x20#x9#xA#xD]+
request ::= ( "#" request-id ( #x20 line-script )? | line-script ) line-end
request-id ::= [^#x20#x9#xA#xD;]+
line-script ::= step ( ";" step )*
line-end ::= #xD? #xA
/* Scripts; MCP's run tool also ends steps at line breaks */
script ::= step ( separator step )*
separator ::= ";" | #xA | #xD
step ::= blank* ( "?"? statement blank* )?
blank ::= #x20 | #x9
statement ::= wait | sample | assert | if | call
/* Constructs */
construct ::= "wait" | "sample" | "assert" | "if"
wait ::= "wait" blank+ ( duration | "idle" | query blank+ "until" blank+ predicates ( blank+ wait-option )* )
wait-option ::= ( "stable=" | "every=" ) duration | "timeout=" ( duration | seconds ) | clock
sample ::= "sample" blank+ sample-query ( blank+ "and" blank+ sample-query )* blank+ "every" blank+ duration ( blank+ count ( blank+ clock )? ( blank+ beside )? | ( blank+ clock )? blank+ beside )
beside ::= "while" blank+ ( wait | call )
clock ::= "clock=" ( "server" | "client" )
assert ::= "assert" blank+ query blank+ predicates
if ::= "if" blank+ query blank+ predicates blank+ "then" blank+ "?"? statement
query ::= ( command-name - construct ) ( blank+ ( token - stop ) )*
sample-query ::= ( command-name - construct ) ( blank+ ( token - ( stop | "and" ) ) )*
stop ::= "ok" | "until" | "every" | "then" | test-shape
/* Calls: the tokens are matched against the command's forms */
call ::= ( command-name - construct ) ( blank+ token )*
command-name ::= ( namespace ":" )? name
name ::= [a-z] [a-z0-9_]*
/* Predicates */
predicates ::= predicate ( blank+ ( "and" blank+ )? predicate )*
predicate ::= "ok" | test
test ::= field-path ( ( "==" | "!=" ) operand | ( "<=" | ">=" | "<" | ">" ) ( decimal | reference ) )
operand ::= reference | value
reference ::= "$" field-path
value ::= ( token-char - [$<>=!&|] ) ( token-char - [<>=!&|] )*
test-shape ::= field-path comparison token-char+
comparison ::= "==" | "!=" | "<=" | ">=" | "<" | ">"
field-path ::= identifier ( "." ( identifier | digits ) )* /* [C] */
/* Tokens */
token ::= token-char+
token-char ::= "\;" | [^#x20#x9#xA#xD;]
identifier ::= [A-Za-z_] [A-Za-z0-9_]*
digits ::= [0-9]+
/* What forms are made of */
option ::= option-name "=" option-value
option-name ::= identifier ( ":" identifier )?
option-value ::= ( token-char - "=" ) token-char*
text ::= token ( blank+ token )*
word ::= token - ( option | test-shape )
/* Slot types */
position ::= "~"? decimal "," decimal "," decimal
point ::= decimal "," decimal
entity ::= "e" digits /* [C] */
widget ::= "w" digits /* [C] */
menu-slot ::= "s" digits /* [C] */
uuid ::= hex8 "-" hex4 "-" hex4 "-" hex4 "-" hex8 hex4
hex8 ::= hex4 hex4
hex4 ::= hex hex hex hex
hex ::= [0-9a-fA-F]
integer ::= "-"? digits /* [C] */
number ::= decimal
decimal ::= "-"? digits ( "." digits )? /* [C] */
count ::= "x" digits /* [C] */
duration ::= digits "t" | seconds "s" /* [C] */
seconds ::= digits ( "." digits )? /* [C] */
id ::= namespace ":" path | bare-id
bare-id ::= path - ( decimal | count | duration | entity | widget | menu-slot | uuid )
namespace ::= [a-z0-9_.-]+
path ::= [a-z0-9_./-]+
tag ::= "#" id
pattern ::= ( [a-z0-9_.:/-]* "*" )+ [a-z0-9_.:/-]*
block-state ::= ( pattern | tag | id ) "[" state ( "," state )* "]"
state ::= state-name "=" state-value
state-name ::= [a-z0-9_]+
state-value ::= [a-z0-9_]+

/* Commands, from their declarations: items are tokens separated by blanks; a command's forms are tried in order against all of a call's tokens, and its options (<command>-option) may stand between any two items, each once. */

help-command ::= "help" word?

fmt-command ::= "fmt" ( "text" | "json" )

sub-command ::= "sub" ( ( "on" | "off" ) | "log" ( "error" | "warn" | "info" | "off" ) )

stop-command ::= "stop"

status-command ::= "status"

look-command ::= "look" integer?
look-option ::= "full"

entity-command ::= "entity" ( "me" | entity )
entity-option ::= "side=" ( "client" | "server" )

find-command ::= "find" ( tag | pattern | id | block-state ) ( integer integer? )?
find-option ::= "side=" ( "client" | "server" )

block-command ::= "block" position "light"?
block-option ::= "side=" ( "client" | "server" )

blocks-command ::= "blocks" position position "grid"?
blocks-option ::= "side=" ( "client" | "server" )

inv-command ::= "inv" "detail"?
inv-option ::= "full"

face-command ::= "face" ( position | entity ) ( "at" position )?
face-option ::= "timeout=" ( duration | seconds )

turn-command ::= "turn" number number duration?
turn-option ::= "timeout=" ( duration | seconds )

move-command ::= "move" ( "forward" | "back" | "left" | "right" ) ( number | duration )
move-option ::= "timeout=" ( duration | seconds )

jump-command ::= "jump"
jump-option ::= "timeout=" ( duration | seconds )

sneak-command ::= "sneak" ( "on" | "off" )?
sneak-option ::= "timeout=" ( duration | seconds )

sprint-command ::= "sprint" ( "on" | "off" )
sprint-option ::= "timeout=" ( duration | seconds )

fly-command ::= "fly" ( "on" | "off" )
fly-option ::= "timeout=" ( duration | seconds )

goto-command ::= "goto" ( position | entity )
goto-option ::= "near=" number | "timeout=" ( duration | seconds )

use-command ::= "use" ( ( position | entity ) ( "at" position )? )? "any"? "sneak"?
use-option ::= "hold=" ( duration | seconds ) | "timeout=" ( duration | seconds )

attack-command ::= "attack" ( entity | id )? count?
attack-option ::= "timeout=" ( duration | seconds )

mine-command ::= "mine" ( position | tag | pattern | id | block-state )? count?
mine-option ::= "timeout=" ( duration | seconds )

place-command ::= "place" id position
place-option ::= "timeout=" ( duration | seconds )

select-command ::= "select" ( integer | id )
select-option ::= "timeout=" ( duration | seconds )

swap-command ::= "swap" ( "head" | "chest" | "legs" | "feet" | "offhand" | integer ) ( "head" | "chest" | "legs" | "feet" | "offhand" | integer )
swap-option ::= "timeout=" ( duration | seconds )

drop-command ::= "drop" ( "head" | "chest" | "legs" | "feet" | "offhand" | integer | id ) integer?
drop-option ::= "timeout=" ( duration | seconds )

offhand-command ::= "offhand" id
offhand-option ::= "timeout=" ( duration | seconds )

equip-command ::= "equip" id
equip-option ::= "timeout=" ( duration | seconds )

chat-command ::= "chat" text
chat-option ::= "timeout=" ( duration | seconds )

cmd-command ::= "cmd" text
cmd-option ::= "timeout=" ( duration | seconds )

open-command ::= "open" position
open-option ::= "timeout=" ( duration | seconds )

take-command ::= "take" ( menu-slot | id ) integer?
take-option ::= "timeout=" ( duration | seconds )

put-command ::= "put" ( menu-slot | id ) integer?
put-option ::= "timeout=" ( duration | seconds )

craft-command ::= "craft" id count?
craft-option ::= "timeout=" ( duration | seconds )

screen-command ::= "screen"
screen-option ::= "full"

mouse-command ::= "mouse" ( ( "down" | "up" ) ( "left" | "right" | "middle" ) | "click" ( "left" | "right" | "middle" ) duration? | "move" number number duration? )
mouse-option ::= "timeout=" ( duration | seconds )

drag-command ::= "drag" ( ( "left" | "right" | "middle" ) number number duration? | ( "left" | "right" | "middle" ) ( point | widget ) ( point | widget ) duration? )
drag-option ::= "timeout=" ( duration | seconds )

cursor-command ::= "cursor" ( point | widget )
cursor-option ::= "timeout=" ( duration | seconds )

click-command ::= "click" ( ( point | widget ) ( "left" | "right" | "middle" )? | menu-slot ( "left" | "right" | "shift" | "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" )? )
click-option ::= "timeout=" ( duration | seconds )

scroll-command ::= "scroll" number ( point | widget )?
scroll-option ::= "timeout=" ( duration | seconds )

key-command ::= "key" ( ( "down" | "up" | "press" ) word duration? | word duration? )
key-option ::= "timeout=" ( duration | seconds )

type-command ::= "type" text
type-option ::= "timeout=" ( duration | seconds )

release-command ::= "release"
release-option ::= "timeout=" ( duration | seconds )

close-command ::= "close"
close-option ::= "timeout=" ( duration | seconds )

worlds-command ::= "worlds"

servers-command ::= "servers"

join-command ::= "join" ( "world" text | "server" ( integer | word ) )
join-option ::= "tick=" "frozen" | "timeout=" ( duration | seconds )

leave-command ::= "leave"
leave-option ::= "timeout=" ( duration | seconds )

quit-command ::= "quit"
quit-option ::= "timeout=" ( duration | seconds )

respawn-command ::= "respawn"
respawn-option ::= "timeout=" ( duration | seconds )

create-command ::= "create" "world" word ( "flat" | "void" | "normal" )? ( "peaceful" | "easy" | "hard" )?
create-option ::= "difficulty=" ( "peaceful" | "easy" | "normal" | "hard" ) | "mode=" ( "creative" | "survival" | "adventure" | "spectator" ) | "seed=" option-value | "rule:" identifier "=" option-value | "timeout=" ( duration | seconds )

snapshot-command ::= "snapshot" ( ( "save" | "restore" | "delete" ) word | "list" )
snapshot-option ::= "timeout=" ( duration | seconds )

delete-command ::= "delete" "world" text
delete-option ::= "timeout=" ( duration | seconds )

server-command ::= "server" text
server-option ::= "as=" "player" | "settle=" ( duration | seconds ) | "timeout=" ( duration | seconds )

nbt-command ::= "nbt" ( position | entity | uuid )
nbt-option ::= "path=" option-value

tick-command ::= "tick" ( ( "freeze" | "unfreeze" | "query" ) | "step" integer | "rate" number )
tick-option ::= "timeout=" ( duration | seconds )

screenshot-command ::= "screenshot" integer? "sheet"?
screenshot-option ::= "burst=" integer | "every=" duration | "hud=" ( "on" | "off" ) | "crop=" option-value | "timeout=" ( duration | seconds )

camera-command ::= "camera" ( "at" position ( "look" ( position | entity ) )? "clear"? | ( "reset" | "off" ) )
camera-option ::= "timeout=" ( duration | seconds )

settle-command ::= "settle"
settle-option ::= "timeout=" ( duration | seconds )

sounds-command ::= "sounds" "playing"?
sounds-option ::= "since=" ( integer | duration ) | "match=" ( pattern | id ) | "limit=" integer

sound-command ::= "sound" id ( "at" position )?
sound-option ::= "volume=" number | "pitch=" number | "source=" word | "timeout=" ( duration | seconds )

messages-command ::= "messages"
messages-option ::= "since=" ( integer | duration ) | "kind=" ( "chat" | "actionbar" | "title" | "subtitle" ) | "match=" option-value | "limit=" integer

particles-command ::= "particles"
particles-option ::= "since=" ( integer | duration )

option-command ::= "option" ( "reset" | word word? )?
option-option ::= "timeout=" ( duration | seconds )

config-command ::= "config" ( "reset" | word ( "client" | "common" | "server" | "startup" ) word? text? | word word? text? )?
config-option ::= "match=" pattern | "timeout=" ( duration | seconds )

pixels-command ::= "pixels" text?

perf-command ::= "perf" ( "start" "profile" word? | "start" ( word "profile"? )? | ( "stop" | "status" ) | duration "profile" word? | duration ( word "profile"? )? )
perf-option ::= "timeout=" ( duration | seconds )

record-command ::= "record" ( "start" word? | ( "stop" | "status" ) | "mark" word | duration word? )
record-option ::= "width=" integer | "fps=" integer | "hud=" ( "on" | "off" ) | "audio=" ( "on" | "off" ) | "timeout=" ( duration | seconds )

load-command ::= "load" ( "off"? | ( "server" | "client" | "net" ) integer )
load-option ::= "jitter=" integer | "timeout=" ( duration | seconds )

log-command ::= "log" ( "mark" | "detail" integer )?
log-option ::= "level=" ( "error" | "warn" | "info" ) | "since=" integer | "grep=" option-value | "logger=" option-value | "limit=" integer

sable.list-command ::= "sable:list" integer?
sable.list-option ::= "side=" ( "client" | "server" )

sable.info-command ::= "sable:info" ( uuid | word ) "brief"?
sable.info-option ::= "side=" ( "client" | "server" )

sable.world-command ::= "sable:world" position

sable.plot-command ::= "sable:plot" ( uuid | word ) position

sable.find-command ::= "sable:find" ( uuid | word ) ( tag | pattern | id | block-state ) integer?
sable.find-option ::= "side=" ( "client" | "server" ) | "sort=" ( "x" | "y" | "z" | "-x" | "-y" | "-z" ) | "near=" position

sable.tp-command ::= "sable:tp" ( position | ( uuid | word ) ( tag | pattern | id | block-state ) )
sable.tp-option ::= "timeout=" ( duration | seconds )
